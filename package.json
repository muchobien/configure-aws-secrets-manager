{
  "name": "@muchobien/configure-aws-secrets-manager",
  "version": "1.0.1",
  "private": true,
  "description": "A Github action to load secrets from AWS Secrets Manager into the environment",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "all": "pnpm build && pnpm format && pnpm lint && pnpm package && pnpm test"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muchobien/configure-aws-secrets-manager.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Rodrigo Sanabria <rodrigo@sanabria.dev>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "2.0.3",
    "@aws-sdk/client-secrets-manager": "3.1117.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.45.0",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jest": "29.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.5.0",
    "js-yaml": "5.4.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
